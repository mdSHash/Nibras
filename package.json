{
  "name": "nibras",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "cd server && npm start",
    "dev:chat-api": "tsx scripts/dev-chat-server.ts",
    "cache-audio": "node scripts/cache-event-audio.js",
    "cache-details": "node scripts/cache-event-details-audio.js",
    "build:chat-kb": "tsx scripts/build-chat-kb.ts",
    "build:embeddings": "tsx scripts/build-chat-embeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:chat": "tsx scripts/eval-chat.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "format": "prettier --write",
    "verify": "tsx scripts/verify.ts",
    "baseline:content": "tsx scripts/baseline/content-snapshot.ts",
    "baseline:behavior": "tsx scripts/baseline/behavior-map.ts",
    "baseline:bundle": "tsx scripts/baseline/bundle-report.ts",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:report": "playwright show-report"
  },
  "dependencies": {
    "@turf/turf": "^7.3.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.6.0",
    "use-supercluster": "^1.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^4.21.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
