# =============================================================================
#  Nibras environment configuration
# =============================================================================
#  Runtime audio is served as static files from public/audio/ (AAC .m4a named by
#  event, listed in public/audio/manifest.json, deployed via GitHub Pages). No
#  cloud storage credentials are needed for the app to run.
#
#  Recording narration (npm run narration -- generate; scripts/narration.ts)
#  reads these from a git-ignored .env.local:
#
#     # Gemini TTS, voice Charon (default engine; spends free-tier quota, ask Mostafa first)
#     GEMINI_API_KEY=your_gemini_api_key_here
#
#     # VoiceStudio running locally (--engine voicestudio; free fallback, also
#     # the Whisper behind npm run narration -- review)
#     VOICESTUDIO_URL=http://localhost:3900     # optional, this is the default
#     VOICESTUDIO_PROFILE=your_voice_profile_id # GET /profiles lists them
#     VOICESTUDIO_ENGINE=                       # optional engine id, e.g. voxcpm2
#     VOICESTUDIO_LANGUAGE=Arabic               # optional, this is the default
#     VOICESTUDIO_SEED=1                        # optional, keeps the voice steady
#
#  Get a Gemini key at https://aistudio.google.com/apikey
# =============================================================================

# =============================================================================
#  Chat assistant (api/chat.ts) — deployed as its own, separate Vercel
#  project, NOT part of the GitHub Pages static deploy. Set these as
#  server-side Environment Variables in that Vercel project's dashboard
#  (never prefix them VITE_ — that would expose them to the client bundle).
#  For local development, put them in a git-ignored .env.local and run
#  `vercel dev` from the repo root.
# =============================================================================
#     GROQ_API_KEY=your_groq_api_key_here
#     OPENROUTER_API_KEY=your_openrouter_api_key_here
#     GEMINI_API_KEY=your_gemini_api_key_here   # query embeddings for semantic search
#
#     # Optional — falls back to a sensible default chain if unset.
#     # Format: "platform:model,platform:model,...", tried in order.
#     LLM_PROVIDER_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.6-27b,groq:openai/gpt-oss-20b,openrouter:google/gemma-4-31b-it:free
#
#     # Comma-separated origins allowed to call the chat API (CORS).
#     ALLOWED_ORIGIN=https://mdshash.github.io,http://localhost:3000,http://localhost:5173
#
#     # Optional — shared answer cache, saved 👍/👎 feedback and the per-IP rate
#     # limit (Upstash Redis REST, added through Vercel's Upstash integration; see
#     # docs/OWNER_DASHBOARD.md). Without these the cache is per-instance memory,
#     # feedback only goes to the function log and the rate limit lets everything through.
#     KV_REST_API_URL=https://your-db.upstash.io
#     KV_REST_API_TOKEN=your_token
#
#     # Local only (`npm run dev:chat-api`): print each question's pipeline trace
#     # and return it as `trace` in the response. Ignored on Vercel.
#     CHAT_TRACE=1
#
#  Get a Groq key at https://console.groq.com/keys
#  Get an OpenRouter key at https://openrouter.ai/keys
#
#  The embedding index (api/_data/chat-embeddings-gemini.json) is built by the
#  "Chat index" GitHub Actions workflow, which reads this from the repository's
#  Actions SECRETS (Settings → Secrets and variables → Actions):
#     GEMINI_API_KEY=your_gemini_api_key_here
#  Locally, `npm run build:embeddings -- gemini` reads it from .env.local.
#
#  The frontend needs to know where this function is deployed — this one IS
#  safe to expose (it's a public URL, not a secret), so it uses the VITE_
#  prefix and lives in the repo root .env (or your shell) at build time:
#
#     VITE_CHAT_API_URL=https://<your-vercel-project>.vercel.app/api/chat
# =============================================================================

# =============================================================================
#  Crash reporting (Sentry) and uptime — see docs/OWNER_DASHBOARD.md
# =============================================================================
#  Set only in CI / Vercel, never locally (local builds and tests send nothing).
#
#  GitHub repository → Settings → Secrets and variables → Actions:
#     VITE_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>   # variable; nibras-web DSN (public by design)
#     SENTRY_ORG=asu-ut                                                  # variable
#     SENTRY_PROJECT=nibras-web                                          # variable
#     SENTRY_AUTH_TOKEN=sntrys_...                                       # SECRET; uploads source maps
#  The deploy job also sets VITE_SENTRY_RELEASE to the commit SHA.
#
#  Vercel project nibras-chat-api → Settings → Environment Variables:
#     SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>        # nibras-chat-api DSN
#
#  Uptime: UptimeRobot checks the site and GET /api/health (no secrets needed).
# =============================================================================
