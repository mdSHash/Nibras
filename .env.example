# BLOB_READ_WRITE_TOKEN: Vercel Blob Storage token for TTS audio caching.
# This token is automatically generated when you create a Blob Store in Vercel.
# Required for: Reading cached TTS audio files from Vercel Blob Storage.
# Setup: Go to Vercel Dashboard > Storage > Create Blob Store > Copy token
# The token format is: vercel_blob_rw_XXXXXXXXXX
# For local development: Copy the token from Vercel Dashboard
# For Vercel deployment: Automatically available as environment variable
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XyI02l4A6Sc7sIpT_Ne7D1AmYc68laCVh7ueBjKxC4LdTH1"
