# GEMINI_API_KEY: Required for Gemini AI API calls and TTS synthesis.
# For Vercel deployment: Add this to your Vercel project environment variables.
# For local development: Copy this file to .env and add your actual API key.
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# BLOB_READ_WRITE_TOKEN: Vercel Blob Storage token for TTS audio caching.
# This token is automatically generated when you create a Blob Store in Vercel.
# Required for: Caching TTS audio files to reduce API calls and improve performance.
# Setup: Go to Vercel Dashboard > Storage > Create Blob Store > Copy token
# The token format is: vercel_blob_rw_XXXXXXXXXX
# For local development: Copy the token from Vercel Dashboard
# For Vercel deployment: Automatically available as environment variable
BLOB_READ_WRITE_TOKEN="YOUR_VERCEL_BLOB_TOKEN"

# APP_URL: The URL where this application is hosted.
# For Vercel: Automatically set by Vercel at runtime.
# For local development: http://localhost:3000
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLOUD_API_KEY: Google Cloud Text-to-Speech API key (fallback).
# Used as secondary fallback if Gemini TTS is unavailable.
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Cloud Text-to-Speech API in your Google Cloud project.
# If not provided, the app will fallback to browser's Web Speech API.
VITE_GOOGLE_CLOUD_API_KEY="YOUR_GOOGLE_CLOUD_TTS_API_KEY"
